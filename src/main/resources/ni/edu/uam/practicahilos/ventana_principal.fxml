<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="18.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.practicahilos.app.VentanillaController">
    <children>
        <!-- Barra de acento superior #0099ac -->
        <Region prefHeight="5.0" style="-fx-background-color: #0099ac;" />

        <VBox spacing="18.0">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="10.0" />
            </padding>
            <children>
                <!-- Encabezado de la aplicación -->
                <VBox spacing="3.0">
                    <children>
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Sistema de Gestión de Ventanillas" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Monitoreo multihilo y sincronización en tiempo real" />
                    </children>
                </VBox>

                <!-- Tarjetas de Métricas (KPI Cards) -->
                <HBox spacing="12.0">
                    <children>
                        <!-- Tarjeta Estado Ventanilla A -->
                        <VBox HBox.hgrow="ALWAYS" prefWidth="150.0" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 10px 14px;">
                            <children>
                                <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #64748b;" text="VENTANILLA A" />
                                <Label fx:id="etiquetaEstadoA" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0099ac; -fx-padding: 4px 0 0 0;" text="Estado A: En espera" />
                            </children>
                        </VBox>

                        <!-- Tarjeta Estado Ventanilla B -->
                        <VBox HBox.hgrow="ALWAYS" prefWidth="150.0" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 10px 14px;">
                            <children>
                                <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #64748b;" text="VENTANILLA B" />
                                <Label fx:id="etiquetaEstadoB" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0099ac; -fx-padding: 4px 0 0 0;" text="Estado B: En espera" />
                            </children>
                        </VBox>

                        <!-- Tarjeta Contador Total -->
                        <VBox HBox.hgrow="ALWAYS" prefWidth="140.0" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 10px 14px;">
                            <children>
                                <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #64748b;" text="TOTAL OPERACIONES" />
                                <Label fx:id="etiquetaContador" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0099ac; -fx-padding: 2px 0 0 0;" text="0" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Botones de Acción -->
                <HBox alignment="CENTER" spacing="12.0">
                    <children>
                        <Button fx:id="btnIniciar" onAction="#iniciarProceso" prefHeight="36.0" prefWidth="150.0" style="-fx-background-color: #0099ac; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" text="Iniciar Operaciones" />
                        <Button fx:id="btnDetener" disable="true" onAction="#detenerProceso" prefHeight="36.0" prefWidth="130.0" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" text="Detener" />
                    </children>
                </HBox>

                <!-- Terminal de Monitoreo -->
                <VBox spacing="6.0">
                    <children>
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="TERMINAL DE MONITOREO DE HILOS" />
                        <TextArea fx:id="areaRegistro" editable="false" prefHeight="220.0" prefWidth="480.0" style="-fx-control-inner-background: #0f172a; -fx-text-fill: #38bdf8; -fx-font-family: 'Consolas', 'Courier New', monospace; -fx-font-size: 12px; -fx-border-color: #334155; -fx-border-radius: 6px; -fx-background-radius: 6px;" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</VBox>